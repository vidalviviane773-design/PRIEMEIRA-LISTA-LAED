def intersecao_listas(U, V):
    conjunto_u = set(U)
    comuns = set()

    for num in V:
        if num in conjunto_u:
            comuns.add(num)

    return ", ".join(map(str, comuns))

U = [9, 2, 77, 2, 2, 1, 7, 7, 9]
V = [2, 15, 19, 12, 33, 9, 17, 41, 54, 8]
print("Interseção:", intersecao_listas(U, V))
